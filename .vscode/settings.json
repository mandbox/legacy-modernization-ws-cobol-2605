{
  // ⚠️ VS Code 1.102 で deprecated — codeGeneration.instructions と
  // testGeneration.instructions は廃止されました。代わりに Phase 4 の
  // ファイルベース instructions（.github/copilot-instructions.md は
  // プロジェクト全体に自動ロード、.github/instructions/*.instructions.md
  // は applyTo glob で自動適用）を使ってください。今も有効な 3 つの
  // 設定キーは以下のとおりです。
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Use Conventional Commits format: type(scope): description.\nValid types (use these EXACT English tokens — do not translate to Japanese or any other language): feat, fix, docs, refactor, test, chore.\nValid scopes: syllabus, library, hr-cobol, build, docs.\nSubject line <=72 chars; lowercase; no period at end.\nFor refactor commits, mention which COBOL paragraph or copybook changed.\nExample correct: \"fix(syllabus): correct WS-LINE-COUNT reset condition\"\nExample incorrect (do NOT do this): \"修正(syllabus): ...\" / \"Fix(syllabus): ...\" / \"FIX(syllabus): ...\""
    }
  ],
  "github.copilot.chat.pullRequestDescriptionGeneration.instructions": [
    {
      "text": "Generate the PR description with these sections, in this order:\n\n## What\n[1-2 sentences on the change]\n\n## Why\n[Reference the issue or motivation]\n\n## Affected COBOL modules\n[List which Syllabus / Library / HR-COBOL programs are touched]\n\n## How tested\n[Build verified? `make` succeeds? Manual run? Mock data?]\n\n## ADR\n[If architectural, link the docs/adr/ entry; otherwise write 'N/A']"
    }
  ],
  "github.copilot.chat.reviewSelection.instructions": [
    {
      "text": "When reviewing COBOL code in this repo, check:\n1. Variable names follow convention (WS- for working-storage, FD- for file description, LK- for linkage section).\n2. PERFORM ... THRU ranges are correct (no missing labels; no fall-through past the THRU target).\n3. File I/O uses correct status code checks immediately after each READ/WRITE/REWRITE/DELETE.\n4. No hardcoded paths; copybooks are referenced via COPY statement, not duplicated inline.\n5. CALL statements use 8-character upper-case program names matching real source files.\n6. Every paragraph either ends with EXIT or falls through to a clearly-labeled successor.\nFlag any deviation. For each issue, suggest a specific, minimal fix in code-block form."
    }
  ]
}